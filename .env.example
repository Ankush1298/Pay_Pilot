# Default: simulated ledger. No network, no tokens, no deployment needed. Nothing below is required for the demo.
PAYPILOT_LEDGER=simulated
PAYPILOT_RP_ID=localhost
# Extra browser origins allowed to call the API (comma-separated). localhost:3000/8000 and 127.0.0.1 are built in.
# PAYPILOT_ORIGINS=https://app.example.com
# 64 hex chars (openssl rand -hex 32). If unset, a random per-process key is used (fine while state is in memory).
# PAYPILOT_MASTER_KEY=

# --- OPTIONAL live Monad testnet mode (not needed for the hackathon demo). Never commit real values. ---
# PAYPILOT_LEDGER=live
# MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
# MONAD_EXPLORER_URL=https://testnet.monadvision.com
# PAYPILOT_RELAYER_KEY=
# PAYPILOT_POLICY_SIGNER_KEY=
# PAYPILOT_DEPLOYMENTS=deployments.json
# PAYPILOT_INR_PER_MON=100

# Automated tests only (pytest sets this for you).
PAYPILOT_TEST_MODE=0

# --- Database. MySQL for real use (create the database and a dedicated user first). Without this, a local SQLite file is used.
# PAYPILOT_DATABASE_URL=mysql+pymysql://paypilot:CHANGE_ME@127.0.0.1:3306/paypilot?charset=utf8mb4
# Global per-IP ceiling on /api requests per minute (login, chat and payment endpoints have stricter limits of their own).
# PAYPILOT_RATE_LIMIT_PER_MIN=240
